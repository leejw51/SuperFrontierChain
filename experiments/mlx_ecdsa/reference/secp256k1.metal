// Experimental public-data recovery only. Not audited; never use for signing.
// Constants and Montgomery-domain values are generated by recovery.py.
struct U256x { uint w[8]; };
struct JPoint { U256x x; U256x y; U256x z; };

U256x load_constant(constant uint* a) {
    U256x r;
    for (uint i=0; i<8; ++i) r.w[i]=a[i];
    return r;
}
U256x zero256() { U256x r; for (uint i=0; i<8; ++i) r.w[i]=0; return r; }
U256x small256(uint x) { U256x r=zero256(); r.w[0]=x; return r; }
bool is_zero(U256x a) {
    uint v=0; for (uint i=0; i<8; ++i) v|=a.w[i]; return v==0;
}
bool equal256(U256x a, U256x b) {
    uint v=0; for (uint i=0; i<8; ++i) v|=a.w[i]^b.w[i]; return v==0;
}
bool ge256(U256x a, U256x b) {
    for (int i=7; i>=0; --i) { if(a.w[i]!=b.w[i]) return a.w[i]>b.w[i]; }
    return true;
}
U256x subtract_raw(U256x a, U256x b) {
    U256x r; ulong borrow=0;
    for (uint i=0; i<8; ++i) {
        ulong rhs=ulong(b.w[i])+borrow;
        r.w[i]=uint(ulong(a.w[i])-rhs); borrow=ulong(a.w[i])<rhs;
    }
    return r;
}
template<bool Scalar> U256x modulus() { return load_constant(Scalar ? MOD_N : MOD_P); }
template<bool Scalar> U256x one_mont() { return load_constant(Scalar ? ONE_N : ONE_P); }
template<bool Scalar> U256x add_mod(U256x a, U256x b) {
    U256x r; ulong carry=0;
    for(uint i=0;i<8;++i) { ulong t=ulong(a.w[i])+b.w[i]+carry; r.w[i]=uint(t); carry=t>>32; }
    U256x m=modulus<Scalar>();
    if(carry || ge256(r,m)) r=subtract_raw(r,m);
    return r;
}
template<bool Scalar> U256x sub_mod(U256x a, U256x b) {
    if(ge256(a,b)) return subtract_raw(a,b);
    return subtract_raw(modulus<Scalar>(), subtract_raw(b,a));
}
// Schoolbook product plus radix-2^32 Montgomery REDC. Each multiply-add fits
// exactly in ulong: (2^32-1)^2 + 2*(2^32-1) == 2^64-1.
template<bool Scalar> U256x mul_mod(U256x a, U256x b) {
    uint t[18]; for(uint i=0;i<18;++i) t[i]=0;
    for(uint i=0;i<8;++i) {
        ulong carry=0;
        for(uint j=0;j<8;++j) {
            ulong v=ulong(a.w[i])*b.w[j]+t[i+j]+carry;
            t[i+j]=uint(v); carry=v>>32;
        }
        t[i+8]=uint(carry);
    }
    U256x m=modulus<Scalar>();
    const uint inv=Scalar ? INV_N : INV_P;
    for(uint i=0;i<8;++i) {
        uint q=t[i]*inv; ulong carry=0;
        for(uint j=0;j<8;++j) {
            ulong v=ulong(q)*m.w[j]+t[i+j]+carry;
            t[i+j]=uint(v); carry=v>>32;
        }
        uint k=i+8;
        while(carry!=0 && k<18) {
            ulong v=ulong(t[k])+carry; t[k]=uint(v); carry=v>>32; ++k;
        }
    }
    U256x r; for(uint i=0;i<8;++i) r.w[i]=t[i+8];
    if(t[16]!=0 || ge256(r,m)) r=subtract_raw(r,m);
    return r;
}
template<bool Scalar> U256x to_mont(U256x a) {
    return mul_mod<Scalar>(a,load_constant(Scalar ? R2_N : R2_P));
}
template<bool Scalar> U256x from_mont(U256x a) { return mul_mod<Scalar>(a,small256(1)); }
template<bool Scalar> U256x power(U256x a, U256x e) {
    U256x r=one_mont<Scalar>();
    for(int bit=255;bit>=0;--bit) {
        r=mul_mod<Scalar>(r,r);
        if((e.w[bit/32]>>(bit%32))&1) r=mul_mod<Scalar>(r,a);
    }
    return r;
}
U256x fadd(U256x a,U256x b) { return add_mod<false>(a,b); }
U256x fsub(U256x a,U256x b) { return sub_mod<false>(a,b); }
U256x fmul(U256x a,U256x b) { return mul_mod<false>(a,b); }
U256x twice(U256x a) { return fadd(a,a); }
JPoint infinity() { return {zero256(),one_mont<false>(),zero256()}; }
JPoint point_double(JPoint p) {
    if(is_zero(p.z) || is_zero(p.y)) return infinity();
    U256x a=fmul(p.x,p.x), b=fmul(p.y,p.y), c=fmul(b,b);
    U256x xb=fadd(p.x,b);
    U256x d=twice(fsub(fsub(fmul(xb,xb),a),c));
    U256x e=fadd(twice(a),a), f=fmul(e,e);
    U256x x=fsub(f,twice(d));
    U256x y=fsub(fmul(e,fsub(d,x)),twice(twice(twice(c))));
    return {x,y,twice(fmul(p.y,p.z))};
}
JPoint point_add_affine(JPoint p,U256x x,U256x y) {
    if(is_zero(p.z)) return {x,y,one_mont<false>()};
    U256x zz=fmul(p.z,p.z), u=fmul(x,zz), s=fmul(y,fmul(p.z,zz));
    U256x h=fsub(u,p.x), r=fsub(s,p.y);
    if(is_zero(h)) return is_zero(r) ? point_double(p) : infinity();
    U256x hh=fmul(h,h), hhh=fmul(h,hh), v=fmul(p.x,hh);
    U256x nx=fsub(fsub(fmul(r,r),hhh),twice(v));
    return {nx,fsub(fmul(r,fsub(v,nx)),fmul(p.y,hhh)),fmul(p.z,h)};
}
// One lane recovers one signature; all intermediate field/group state is private.
bool recover_key(U256x z,U256x r,U256x s,uint parity,thread U256x& qx,thread U256x& qy) {
    U256x n=modulus<true>();
    if(parity>1 || is_zero(r) || is_zero(s) || ge256(r,n) || ge256(s,n)) return false;
    if(ge256(s,load_constant(HALF_N_PLUS_ONE))) return false;
    U256x rx=to_mont<false>(r);
    U256x y2=fadd(fmul(fmul(rx,rx),rx),to_mont<false>(small256(7)));
    U256x ry=power<false>(y2,load_constant(SQRT_P));
    if(!equal256(fmul(ry,ry),y2)) return false;
    if((from_mont<false>(ry).w[0]&1)!=parity) ry=fsub(zero256(),ry);
    if(ge256(z,n)) z=subtract_raw(z,n);
    U256x ri=power<true>(to_mont<true>(r),load_constant(N_MINUS_TWO));
    U256x a=from_mont<true>(mul_mod<true>(sub_mod<true>(zero256(),to_mont<true>(z)),ri));
    U256x b=from_mont<true>(mul_mod<true>(to_mont<true>(s),ri));
    U256x gx=load_constant(GX_MONT),gy=load_constant(GY_MONT);
    JPoint q=infinity();
    for(int bit=255;bit>=0;--bit) {
        q=point_double(q);
        if((a.w[bit/32]>>(bit%32))&1) q=point_add_affine(q,gx,gy);
        if((b.w[bit/32]>>(bit%32))&1) q=point_add_affine(q,rx,ry);
    }
    if(is_zero(q.z)) return false;
    U256x zi=power<false>(q.z,load_constant(P_MINUS_TWO)),zi2=fmul(zi,zi);
    qx=from_mont<false>(fmul(q.x,zi2));
    qy=from_mont<false>(fmul(q.y,fmul(zi,zi2)));
    return true;
}
