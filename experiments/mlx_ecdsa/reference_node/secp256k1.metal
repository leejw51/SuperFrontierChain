// Experimental public-data recovery only. Not audited; never use for signing.
// Constants are generated by recovery.py. Field values are normal-domain;
// scalar values use Montgomery representation.
struct U256x { uint w[8]; };
struct JPoint { U256x x; U256x y; U256x z; };

U256x load_constant(constant uint* a) {
    U256x r;
    for (uint i=0; i<8; ++i) r.w[i]=a[i];
    return r;
}
U256x zero256() { U256x r; for (uint i=0; i<8; ++i) r.w[i]=0; return r; }
U256x small256(uint x) { U256x r=zero256(); r.w[0]=x; return r; }
bool is_zero(U256x a) {
    uint v=0; for (uint i=0; i<8; ++i) v|=a.w[i]; return v==0;
}
bool equal256(U256x a, U256x b) {
    uint v=0; for (uint i=0; i<8; ++i) v|=a.w[i]^b.w[i]; return v==0;
}
bool ge256(U256x a, U256x b) {
    for (int i=7; i>=0; --i) { if(a.w[i]!=b.w[i]) return a.w[i]>b.w[i]; }
    return true;
}
U256x subtract_raw(U256x a, U256x b) {
    U256x r; ulong borrow=0;
    for (uint i=0; i<8; ++i) {
        ulong rhs=ulong(b.w[i])+borrow;
        r.w[i]=uint(ulong(a.w[i])-rhs); borrow=ulong(a.w[i])<rhs;
    }
    return r;
}
template<bool Scalar> U256x modulus() { return load_constant(Scalar ? MOD_N : MOD_P); }
template<bool Scalar> U256x one_mont() { return load_constant(Scalar ? ONE_N : ONE_P); }
template<bool Scalar> U256x add_mod(U256x a, U256x b) {
    U256x r; ulong carry=0;
    for(uint i=0;i<8;++i) { ulong t=ulong(a.w[i])+b.w[i]+carry; r.w[i]=uint(t); carry=t>>32; }
    U256x m=modulus<Scalar>();
    if(carry || ge256(r,m)) r=subtract_raw(r,m);
    return r;
}
template<bool Scalar> U256x sub_mod(U256x a, U256x b) {
    if(ge256(a,b)) return subtract_raw(a,b);
    return subtract_raw(modulus<Scalar>(), subtract_raw(b,a));
}
// Schoolbook product plus radix-2^32 Montgomery REDC. Each multiply-add fits
// exactly in ulong: (2^32-1)^2 + 2*(2^32-1) == 2^64-1.
void product_wide(U256x a,U256x b,thread uint* t) {
    for(uint i=0;i<18;++i) t[i]=0;
    #pragma unroll
    for(uint i=0;i<8;++i) {
        ulong carry=0;
        #pragma unroll
        for(uint j=0;j<8;++j) {
            ulong v=ulong(a.w[i])*b.w[j]+t[i+j]+carry;
            t[i+j]=uint(v); carry=v>>32;
        }
        t[i+8]=uint(carry);
    }
}
template<bool Scalar> U256x mul_mod(U256x a, U256x b) {
    uint t[18]; product_wide(a,b,t);
    U256x m=modulus<Scalar>();
    if (!Scalar) {
        // p = 2^256 - 2^32 - 977: fold H*2^256 into H*(2^32+977).
        // The first fold fits ten limbs; the second fits nine. If the
        // second overflows, its low part is small enough that the third
        // cannot overflow. One final subtraction canonicalizes the result.
        U256x r; ulong carry=0;
        #pragma unroll
        for(uint i=0;i<8;++i) {
            ulong v=ulong(t[i])+ulong(t[i+8])*977+carry;
            if(i>0) v+=t[i+7];
            r.w[i]=uint(v); carry=v>>32;
        }
        ulong high=ulong(t[15])+carry;
        uint h0=uint(high), h1=uint(high>>32);
        carry=0;
        #pragma unroll
        for(uint i=0;i<8;++i) {
            ulong v=ulong(r.w[i])+carry;
            if(i==0) v+=ulong(h0)*977;
            if(i==1) v+=ulong(h0)+ulong(h1)*977;
            if(i==2) v+=h1;
            r.w[i]=uint(v); carry=v>>32;
        }
        uint overflow=uint(carry); carry=0;
        #pragma unroll
        for(uint i=0;i<8;++i) {
            ulong v=ulong(r.w[i])+carry;
            if(i==0) v+=ulong(overflow)*977;
            if(i==1) v+=overflow;
            r.w[i]=uint(v); carry=v>>32;
        }
        if(ge256(r,m)) r=subtract_raw(r,m);
        return r;
    }
    const uint inv=Scalar ? INV_N : INV_P;
    #pragma unroll
    for(uint i=0;i<8;++i) {
        uint q=t[i]*inv; ulong carry=0;
        #pragma unroll
        for(uint j=0;j<8;++j) {
            ulong v=ulong(q)*m.w[j]+t[i+j]+carry;
            t[i+j]=uint(v); carry=v>>32;
        }
        uint k=i+8;
        while(carry!=0 && k<18) {
            ulong v=ulong(t[k])+carry; t[k]=uint(v); carry=v>>32; ++k;
        }
    }
    U256x r; for(uint i=0;i<8;++i) r.w[i]=t[i+8];
    if(t[16]!=0 || ge256(r,m)) r=subtract_raw(r,m);
    return r;
}
template<bool Scalar> U256x to_mont(U256x a) {
    if(!Scalar) return a;
    return mul_mod<Scalar>(a,load_constant(Scalar ? R2_N : R2_P));
}
template<bool Scalar> U256x from_mont(U256x a) {
    if(!Scalar) return a;
    return mul_mod<Scalar>(a,small256(1));
}
template<bool Scalar> U256x square_n(U256x a,uint count) {
    for(uint i=0;i<count;++i) a=mul_mod<Scalar>(a,a);
    return a;
}
// FIXED_POWER_FUNCTIONS
template<bool Scalar> U256x power(U256x a, U256x e) {
    if(Scalar && equal256(e,load_constant(N_MINUS_TWO))) return inverse_scalar(a);
    if(!Scalar && equal256(e,load_constant(P_MINUS_TWO))) return inverse_field(a);
    if(!Scalar && equal256(e,load_constant(SQRT_P))) return sqrt_field(a);
    U256x r=one_mont<Scalar>();
    for(int bit=255;bit>=0;--bit) {
        r=mul_mod<Scalar>(r,r);
        if((e.w[bit/32]>>(bit%32))&1) r=mul_mod<Scalar>(r,a);
    }
    return r;
}
U256x fadd(U256x a,U256x b) { return add_mod<false>(a,b); }
U256x fsub(U256x a,U256x b) { return sub_mod<false>(a,b); }
U256x fmul(U256x a,U256x b) { return mul_mod<false>(a,b); }
U256x twice(U256x a) { return fadd(a,a); }
JPoint infinity() { return {zero256(),one_mont<false>(),zero256()}; }
JPoint point_double(JPoint p) {
    if(is_zero(p.z) || is_zero(p.y)) return infinity();
    U256x a=fmul(p.x,p.x), b=fmul(p.y,p.y), c=fmul(b,b);
    U256x xb=fadd(p.x,b);
    U256x d=twice(fsub(fsub(fmul(xb,xb),a),c));
    U256x e=fadd(twice(a),a), f=fmul(e,e);
    U256x x=fsub(f,twice(d));
    U256x y=fsub(fmul(e,fsub(d,x)),twice(twice(twice(c))));
    return {x,y,twice(fmul(p.y,p.z))};
}
JPoint point_add_affine(JPoint p,U256x x,U256x y) {
    if(is_zero(p.z)) return {x,y,one_mont<false>()};
    U256x zz=fmul(p.z,p.z), u=fmul(x,zz), s=fmul(y,fmul(p.z,zz));
    U256x h=fsub(u,p.x), r=fsub(s,p.y);
    if(is_zero(h)) return is_zero(r) ? point_double(p) : infinity();
    U256x hh=fmul(h,h), hhh=fmul(h,hh), v=fmul(p.x,hh);
    U256x nx=fsub(fsub(fmul(r,r),hhh),twice(v));
    return {nx,fsub(fmul(r,fsub(v,nx)),fmul(p.y,hhh)),fmul(p.z,h)};
}

U256x rounded_product_shift384(U256x a,U256x b) {
    uint t[18]; product_wide(a,b,t);
    U256x r=zero256(); ulong carry=t[11]>>31;
    for(uint i=0;i<4;++i) { ulong v=ulong(t[12+i])+carry; r.w[i]=uint(v); carry=v>>32; }
    return r;
}

// GLV lattice decomposition: k = k1 + lambda*k2 (mod n), with signed
// magnitudes below 2^128. Constants follow the public secp256k1 lattice;
// rounded 384-bit products replace division by the curve order.
uint split_scalar(U256x k,thread U256x& k1,thread U256x& k2) {
    U256x c1=to_mont<true>(rounded_product_shift384(k,load_constant(SPLIT_G1)));
    U256x c2=to_mont<true>(rounded_product_shift384(k,load_constant(SPLIT_G2)));
    U256x r2=add_mod<true>(mul_mod<true>(c1,load_constant(MINUS_B1_MONT)),
                          mul_mod<true>(c2,load_constant(MINUS_B2_MONT)));
    U256x r1=sub_mod<true>(to_mont<true>(k),mul_mod<true>(r2,load_constant(LAMBDA_MONT)));
    k1=from_mont<true>(r1); k2=from_mont<true>(r2);
    uint signs=0;
    if(ge256(k1,load_constant(HALF_N_PLUS_ONE))) { k1=subtract_raw(modulus<true>(),k1); signs|=1; }
    if(ge256(k2,load_constant(HALF_N_PLUS_ONE))) { k2=subtract_raw(modulus<true>(),k2); signs|=2; }
    return signs;
}
// Preparation and multiplication are separate kernels: the multiplication
// kernel reads tables from device memory instead of retaining 16 private points.
template<bool Direct> void prepare_windowed(U256x z,U256x r,U256x s,uint parity,U256x ri,device uint* table) {
    for(uint j=0;j<(Direct ? 273u : 401u);++j) table[j]=0;
    U256x n=modulus<true>();
    if(parity>1 || is_zero(r) || is_zero(s) || ge256(r,n) || ge256(s,n) ||
       ge256(s,load_constant(HALF_N_PLUS_ONE))) return;
    U256x rx=r;
    U256x y2=fadd(fmul(fmul(rx,rx),rx),small256(7));
    U256x ry=sqrt_field(y2);
    if(!equal256(fmul(ry,ry),y2)) return;
    if((ry.w[0]&1)!=parity) ry=fsub(zero256(),ry);
    if(ge256(z,n)) z=subtract_raw(z,n);
    U256x a=from_mont<true>(mul_mod<true>(sub_mod<true>(zero256(),to_mont<true>(z)),ri));
    U256x b=from_mont<true>(mul_mod<true>(to_mont<true>(s),ri));
    if(Direct) {
        JPoint points[16]; U256x prefix[16];
        points[1]={rx,ry,small256(1)};
        for(uint j=2;j<16;++j) points[j]=point_add_affine(points[j-1],rx,ry);
        U256x product=small256(1);
        for(uint j=1;j<16;++j) { prefix[j]=product; product=fmul(product,points[j].z); }
        U256x inverse=inverse_field(product);
        for(int j=15;j>=1;--j) {
            U256x zi=fmul(inverse,prefix[j]); inverse=fmul(inverse,points[j].z);
            U256x zi2=fmul(zi,zi);
            U256x x=fmul(points[j].x,zi2),y=fmul(points[j].y,fmul(zi2,zi));
            for(uint k=0;k<8;++k) { table[17+j*16+k]=x.w[k]; table[17+j*16+8+k]=y.w[k]; }
        }
    } else {
        JPoint point={rx,ry,small256(1)};
        for(uint j=1;j<16;++j) {
            for(uint k=0;k<8;++k) {
                table[17+j*24+k]=point.x.w[k]; table[17+j*24+8+k]=point.y.w[k];
                table[17+j*24+16+k]=point.z.w[k];
            }
            if(j<15) point=point_add_affine(point,rx,ry);
        }
    }
    U256x k1,k2; uint signs=split_scalar(b,k1,k2);
    table[0]=1|(signs<<1);
    for(uint k=0;k<8;++k) table[1+k]=a.w[k];
    for(uint k=0;k<4;++k) { table[9+k]=k1.w[k]; table[13+k]=k2.w[k]; }
}

U256x table_z(const device uint* points,uint index) {
    uint offset=(index/16)*401+17+(index%16)*24;
    U256x z; for(uint k=0;k<8;++k) z.w[k]=points[offset+16+k];
    return is_zero(z) ? small256(1) : z;
}
void batch_normalize_tables(const device uint* points,device uint* tables,uint start,uint count) {
    U256x prefix[128],product=small256(1);
    for(uint j=0;j<count;++j) { prefix[j]=product; product=fmul(product,table_z(points,start+j)); }
    U256x inv=inverse_field(product);
    for(int j=int(count)-1;j>=0;--j) {
        uint index=start+uint(j),record=index/16,entry=index%16;
        uint offset=record*401+17+entry*24,out=record*273+17+entry*16;
        U256x zi=fmul(inv,prefix[j]); inv=fmul(inv,table_z(points,index));
        U256x x,y;
        for(uint k=0;k<8;++k) { x.w[k]=points[offset+k]; y.w[k]=points[offset+8+k]; }
        U256x zi2=fmul(zi,zi); x=fmul(x,zi2); y=fmul(y,fmul(zi,zi2));
        for(uint k=0;k<8;++k) { tables[out+k]=x.w[k]; tables[out+8+k]=y.w[k]; }
        if(entry==0) for(uint k=0;k<17;++k) tables[record*273+k]=points[record*401+k];
    }
}

bool recover_windowed(const device uint* table,thread U256x& qx,thread U256x& qy,thread U256x& qz) {
    if(table[0]==0) return false;
    JPoint q=infinity();
    for(int window=31;window>=0;--window) {
        for(uint j=0;j<4;++j) q=point_double(q);
        uint ga=(table[1+window/8]>>((window%8)*4))&15;
        uint ga_hi=(table[5+window/8]>>((window%8)*4))&15;
        uint rb=(table[9+window/8]>>((window%8)*4))&15;
        uint rb_phi=(table[13+window/8]>>((window%8)*4))&15;
        uint combined=ga|(ga_hi<<4);
        if(combined) {
            U256x x,y;
            for(uint k=0;k<8;++k) { x.w[k]=TABLE_G_COMB[combined][k]; y.w[k]=TABLE_G_COMB[combined][8+k]; }
            q=point_add_affine(q,x,y);
        }
        if(rb) {
            U256x x,y;
            for(uint k=0;k<8;++k) { x.w[k]=table[17+rb*16+k]; y.w[k]=table[17+rb*16+8+k]; }
            if(table[0]&2) y=fsub(zero256(),y);
            q=point_add_affine(q,x,y);
        }
        if(rb_phi) {
            U256x x,y;
            for(uint k=0;k<8;++k) { x.w[k]=table[17+rb_phi*16+k]; y.w[k]=table[17+rb_phi*16+8+k]; }
            x=fmul(x,load_constant(BETA));
            if(table[0]&4) y=fsub(zero256(),y);
            q=point_add_affine(q,x,y);
        }
    }
    if(is_zero(q.z)) return false;
    qx=q.x; qy=q.y; qz=q.z;
    return true;
}

U256x scalar_record(const device uint* records,uint index) {
    U256x r; for(uint k=0;k<8;++k) r.w[k]=records[index*25+8+k];
    if(is_zero(r) || ge256(r,modulus<true>())) return one_mont<true>();
    return to_mont<true>(r);
}
void batch_inverse_r(const device uint* records,device uint* inverses,uint start,uint count) {
    U256x prefix[32],product=one_mont<true>();
    for(uint j=0;j<count;++j) { prefix[j]=product; product=mul_mod<true>(product,scalar_record(records,start+j)); }
    U256x inv=inverse_scalar(product);
    for(int j=int(count)-1;j>=0;--j) {
        U256x value=mul_mod<true>(inv,prefix[j]);
        inv=mul_mod<true>(inv,scalar_record(records,start+uint(j)));
        for(uint k=0;k<8;++k) inverses[(start+uint(j))*8+k]=value.w[k];
    }
}
U256x point_z(const device uint* points,uint index) {
    if(points[index*25]==0) return small256(1);
    U256x z; for(uint k=0;k<8;++k) z.w[k]=points[index*25+17+k];
    return z;
}
void batch_normalize(const device uint* points,device uint* results,uint start,uint count) {
    U256x prefix[32],product=small256(1);
    for(uint j=0;j<count;++j) { prefix[j]=product; product=fmul(product,point_z(points,start+j)); }
    U256x inv=inverse_field(product);
    for(int j=int(count)-1;j>=0;--j) {
        uint index=start+uint(j);
        U256x zi=fmul(inv,prefix[j]); inv=fmul(inv,point_z(points,index));
        U256x x,y; uint valid=points[index*25];
        for(uint k=0;k<8;++k) { x.w[k]=points[index*25+1+k]; y.w[k]=points[index*25+9+k]; }
        U256x zi2=fmul(zi,zi); x=fmul(x,zi2); y=fmul(y,fmul(zi,zi2));
        results[index*17]=valid;
        for(uint k=0;k<8;++k) { results[index*17+1+k]=valid ? x.w[k] : 0; results[index*17+9+k]=valid ? y.w[k] : 0; }
    }
}
